# ---------- Login (single owner account) ----------
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
AUTH_SECRET=
# Public address once hosted (used in WhatsApp reminders and webhook registration)
PUBLIC_URL=

# ---------- Gemini (custom web-to-API server) ----------
GEMINI_BASE_URL=https://custom-model.duckdns.org/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
GEMINI_SESSION_ID=gacdesk

# ---------- Speech to text for client voice notes (Whisper, OpenAI-compatible) ----------
# Free option: Groq (console.groq.com) -> WHISPER_BASE_URL=https://api.groq.com/openai/v1, WHISPER_MODEL=whisper-large-v3
WHISPER_BASE_URL=https://api.groq.com/openai/v1
WHISPER_API_KEY=
WHISPER_MODEL=whisper-large-v3

# ---------- WhatsApp (ChatSlash / OpenWA gateway) ----------
WA_BASE_URL=https://ahmad-wasender.duckdns.org
WA_SESSION_ID=de7d8a2d-2338-4eae-8049-9e7d9f17042f
WA_API_KEY=
WA_WEBHOOK_SECRET=
# Your own number: reminders and new-email alerts are sent here (e.g. 923001234567)
REMINDER_WHATSAPP_TO=
REMINDER_MINUTES=10
REMINDER_AFTER_MINUTES=5

# ---------- ClickUp ----------
CLICKUP_TOKEN=
CLICKUP_TEAM_ID=9009178151

# ---------- Email (IMAP + SMTP). Titan/Zoho: normal password. Gmail: App Password ----------
EMAIL1_PROVIDER=titan
EMAIL1_LABEL=Titan
EMAIL1_USER=
EMAIL1_PASS=
# EMAIL2_PROVIDER=gmail
# EMAIL2_LABEL=Gmail
# EMAIL2_USER=
# EMAIL2_PASS=

# ---------- Team reply links: Name:token, comma separated ----------
TEAM_TOKENS="Tulaib Yaseen:make-a-long-random-token"
STT_PROVIDER=local
LOCAL_WHISPER_MODEL=onnx-community/whisper-base
STT_LANGUAGES=english,urdu,hindi
STT_IDLE_MINUTES=10
VOICE_COMMANDS=browser

# Supabase Postgres via the SESSION pooler (port 5432). Leave empty to use a local SQLite file instead.
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=
DATABASE_PASSWORD=
